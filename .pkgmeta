# Ein Addon-Ordner im Repo (Glimpse_Professions/), alles andere liegt daneben. Der Packager baut im Ordner Glimpse_Professions, schiebt den
# Inhalt des Addon-Ordners eine Ebene hoch; was außen liegt, bleibt über "ignore" draußen.
package-as: Glimpse_Professions

move-folders:
  Glimpse_Professions/Glimpse_Professions: Glimpse_Professions

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Beziehungen auf CurseForge (Kurznamen der Projekte); externe Addons werden nicht gemeldet
required-dependencies:
  - glimpse

ignore:
  - tests
  - tools
  - docs
  - .github
  - .luacheckrc
  - .gitattributes
  - .gitignore
  - README.md
  - DEVELOPER.md
  - CHANGELOG.md
  - LICENSE
